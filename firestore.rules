rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    match /tickets/{id} {
      allow get: if true;
      allow list, update, delete: if request.auth != null
        && request.auth.token.email == 'YOU@EMAIL.COM';
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['name','phone','status','created'])
        && request.resource.data.keys().hasAll(['name','phone','status','created'])
        && request.resource.data.name is string
        && request.resource.data.name.size() < 80
        && request.resource.data.created == request.time;
    }
  }
}
